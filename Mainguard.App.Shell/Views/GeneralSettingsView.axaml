<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mainguard.App.Shell.ViewModels"
        x:Class="Mainguard.App.Shell.Views.GeneralSettingsView"
        x:DataType="vm:GeneralSettingsViewModel">
    <UserControl.Styles>
        <!-- Selected theme: same convention as Button.Segment.Active — a class carries the state.
             AccentSelection fill + accent hairline, one per picker (the One Accent Rule reads this
             as selection tint, not a second CTA). -->
        <Style Selector="Button.Secondary.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSelection}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="24" MaxWidth="560">

        <StackPanel Spacing="10">
            <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
            <ItemsControl ItemsSource="{Binding ThemeRows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SettingsThemeRowViewModel">
                        <Button Classes="Secondary" Classes.selected="{Binding IsSelected}"
                                Margin="0,0,8,8" Padding="12,6"
                                Command="{Binding $parent[ItemsControl].((vm:GeneralSettingsViewModel)DataContext).SetThemeCommand}"
                                CommandParameter="{Binding Key}"
                                ToolTip.Tip="{Binding Tooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource CheckmarkIcon}" Width="10" Height="10"
                                          Foreground="{DynamicResource AccentBrush}"
                                          IsVisible="{Binding IsSelected}"/>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding HasAgentPlatform}">
            <TextBlock Text="Layout" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
            <!-- WrapPanel, like the Theme row above it: a horizontal StackPanel cannot reflow, so at a
                 narrow window the second button is simply cut off instead of moving to the next line. -->
            <WrapPanel>
                <Button Content="Flight Deck" Classes="Secondary" Margin="0,0,8,8" Padding="12,6" Command="{Binding SetLayoutCommand}" CommandParameter="FlightDeck"/>
                <Button Content="Conversation Deck" Classes="Secondary" Margin="0,0,8,8" Padding="12,6" Command="{Binding SetLayoutCommand}" CommandParameter="ConversationDeck"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding HasAgentPlatform}">
            <TextBlock Text="Agent prompting" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
            <WrapPanel>
                <Button Content="Direct to agents" Classes="Secondary" Margin="0,0,8,8" Padding="12,6" Command="{Binding SetAgentPromptingCommand}" CommandParameter="Direct"/>
                <Button Content="Through the Coordinator" Classes="Secondary" Margin="0,0,8,8" Padding="12,6" Command="{Binding SetAgentPromptingCommand}" CommandParameter="Coordinator"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="Window &amp; Exit" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
            <CheckBox Content="Close button hides to tray" IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>
            <CheckBox Content="Stop Mainguard OS on exit" IsChecked="{Binding StopVmOnExit, Mode=TwoWay}" IsVisible="{Binding HasAgentPlatform}"/>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="Pinned sidebar icons" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Unpin an item to hide it from the sidebar rail; pinned items stay visible there."
                       Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding PinRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SettingsPinRowViewModel">
                        <CheckBox IsChecked="{Binding IsPinned, Mode=TwoWay}" Content="{Binding Label}"
                                  Foreground="{DynamicResource TextPrimary}" Margin="0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
