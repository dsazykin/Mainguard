# Mainguard orchestration daemon (mainguardd), supervised by systemd inside the MainguardEnv WSL2 VM.
#
# Why systemd: P2-05 StartDaemonStep starts this via `systemctl start mainguardd` and the health path
# greps `pgrep -x mainguardd` / `pgrep -f mainguardd`. The tarball ships this unit (enabled) so the daemon
# comes up on first boot alongside dockerd with no client-side act needed. The published apphost is
# renamed to `mainguardd` in build.sh, so the process comm is exactly `mainguardd` (what pgrep -x matches).
#
# The daemon binds loopback 127.0.0.1:5250 only (DaemonOptions.DefaultPort, invariant 2). WSL2
# localhostForwarding relays the Windows app's 127.0.0.1:5250 connection into this in-VM listener, so
# no non-loopback bind is ever needed.
#
# MG-19: that relay also means loopback is NOT an isolation boundary — the port is reachable from any
# process in the Windows user's session, and from the user's other WSL2 distros. The listener therefore
# serves mutually-authenticated TLS (not h2c), pinned to per-session certificates written beside
# daemon.token; the bearer token is no longer the sole gate. See docs/security-architecture.md.

[Unit]
Description=Mainguard orchestration daemon (mainguardd)
# The daemon starts independently of Docker (it connects to dockerd lazily, only when spawning agents),
# so it is NOT ordered After=docker.service — a slow dockerd never blocks the daemon coming healthy.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the unprivileged VM user (uid 1000). Its `docker` supplementary group (usermod -aG docker
# mainguard in the Dockerfile) is what grants access to the Docker socket for agent spawning; systemd
# applies the user's groups via initgroups for User=. ALL per-user daemon state — session token,
# SQLite, keyring, leader registry, plan store — lands under $HOME/.mainguard (MainguardPaths.DataRoot()).
User=mainguard
Group=mainguard
# HOME set EXPLICITLY as belt-and-braces. The daemon resolves its data root via
# Mainguard.Git.MainguardPaths (DoNotVerify + $HOME fallback + loud failure), so it no longer depends on
# .NET's default GetFolderPath — which VERIFIES existence on Unix and returned "" for the fresh service
# account's never-materialized ~/.local/share, silently producing RELATIVE paths that resolved against
# WorkingDirectory (root-owned /opt/mainguard) or / → EACCES → unhandled exception → restart loop.
Environment=HOME=/home/mainguard
# F53 — the key-ring passphrase. Without it the DataProtection key ring under $HOME/.mainguard/Keyring
# has NO at-rest protector on Linux: its master key sits in plain XML beside the secrets it encrypts,
# the audit chain's master key included. The daemon now refuses to boot in that posture rather than
# silently fall back to an in-memory audit journal that loses every event at shutdown, so this pair of
# lines is what makes a fresh MainguardOS install come up at all — and come up protected.
#
# ExecStartPre runs as ROOT (the `+` prefix; the service itself is User=mainguard) and mints ONE random
# passphrase per install on first boot, into a root-owned 0640 file the daemon's user can read. It is
# never regenerated: a new passphrase would make the existing ring unreadable.
#
# The passphrase is passed as a FILE PATH, never as the passphrase itself — an Environment= secret is
# readable via `systemctl show`, /proc/<pid>/environ and every child process the daemon spawns (which,
# for this daemon, means agent containers). An operator with a stronger custody model points
# MAINGUARD_KEYRING_PASSPHRASE_FILE at their own file instead — e.g. LoadCredential=keyring:/path and
# MAINGUARD_KEYRING_PASSPHRASE_FILE=%d/keyring — and drops the ExecStartPre.
ExecStartPre=+/opt/mainguard/provision-keyring-passphrase.sh
Environment=MAINGUARD_KEYRING_PASSPHRASE_FILE=/etc/mainguard/keyring.passphrase
WorkingDirectory=/opt/mainguard
ExecStart=/opt/mainguard/mainguardd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
