<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mainguard.Server</AssemblyName>
    <RootNamespace>Mainguard.Server</RootNamespace>
    <!-- The daemon publishes for the WSL2 VM (linux-x64), runs on Windows for local-dev, and
         runs natively on the macOS host (osx-arm64) for the macos-host substrate. All must
         build and run (invariant 4). -->
    <RuntimeIdentifiers>linux-x64;win-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Tier-1 daemon fast-path: GetDaemonInfo reports this assembly's informational version and
         the App refreshes the in-VM daemon when it differs from the App's own. Keep these in
         lockstep with Mainguard.App.Shell.csproj's Version — a drifted pair makes every install look
         permanently skewed. Bumped 0.2.4 → 0.2.5 in step 2g: the gRPC package rename (mainguard.v1 →
         mainguard.v1) changes the wire service paths, so the skew check must read as changed.
         Bumped 0.2.5 → 0.2.6. Two independent reasons landed in the same release, both of which
         change the egress-proxy image the DAEMON compares at spawn preflight (versioning-discipline
         rule 3), so the daemon has to ship in step with the image the app builds and labels:
         reload.sh now LOADS the rendered tinyproxy upstreams, and MG-27/MG-36 changed the jail-image
         sources (digest-pinned base images + checksummed toolchain installers) and the daemon spawn
         chain itself (digest-pinned image ref + per-agent network segments). No
         `build/mainguardos/VERSION` cut: the images ship beside the app, not inside the MainguardOS
         tarball. Bumped 0.2.6 → 0.2.7 (MG-41): the egress-proxy image sources moved again —
         entrypoint.sh and reload.sh — so `SandboxImageVersions.EgressProxy` moved, and the daemon
         compares that constant at spawn preflight. Same "no VERSION cut" reasoning as above. -->
    <Version>0.2.7</Version>
    <FileVersion>0.2.7.0</FileVersion>
    <InformationalVersion>0.2.7</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
  </ItemGroup>

  <!-- P2-18: the pinned libvterm (built by build/libvterm/build.sh — CI and packaged builds run it)
       rides with the daemon so the server-side terminal engine can load it beside the binary.
       DAEMON-SIDE ONLY by construction: only this (server) project bundles it, and the client heads
       never reference Mainguard.Server. Absent locally → the engine flag degrades to interim. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\build\libvterm\out\libvterm.so')">
    <None Include="$(MSBuildThisFileDirectory)..\build\libvterm\out\libvterm.so"
          Link="libvterm.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mainguard.Git\Mainguard.Git.csproj" />
    <ProjectReference Include="..\Mainguard.Agents\Mainguard.Agents.csproj" />
    <ProjectReference Include="..\Mainguard.Protos\Mainguard.Protos.csproj" />
  </ItemGroup>

  <!-- WebApplicationFactory<Program> (TI-P2-00 DaemonFixture) needs to see the
       implicit Program entry point. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Mainguard.Server.Tests" />
  </ItemGroup>

</Project>
