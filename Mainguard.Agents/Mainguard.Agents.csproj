<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mainguard.Agents</RootNamespace>
    <AssemblyName>Mainguard.Agents</AssemblyName>
    <!-- P2-18: the libvterm P/Invoke layer (Terminal/Vterm/) marshals fixed-buffer screen cells. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test suite drive internal test seams. Test-only; not for production. -->
    <InternalsVisibleTo Include="Mainguard.Tests" />
  </ItemGroup>

  <!--
    ============== Step 3 (docs/design/code-signing-plan.md): the pinned code-signing thumbprints ==============
    The ONE place a signing identity enters the product. Set $(MainguardPinnedThumbprints) at build time
    (a ';'-separated list of SHA-1 or SHA-256 certificate thumbprints) and this build's
    PinnedThumbprintSignatureVerifier starts enforcing them: an elevated helper or resume target that is
    unsigned, altered, or signed by anyone else is REFUSED. Leave it empty — the default, and what every
    build in this repository produces today — and the honest UnsignedBuildSignatureVerifier ships instead.

    It is assembly METADATA rather than a generated source file on purpose: swapping the self-signed
    certificate for Azure Trusted Signing (step 4, deferred) is then a build-property change and nothing
    else, which is the entire reason the paid certificate is ordered last. build/velopack/pack.ps1 derives
    the value from the signing certificate automatically; build/signing/README.md is the recipe.
  -->
  <PropertyGroup>
    <MainguardPinnedThumbprints Condition="'$(MainguardPinnedThumbprints)' == ''"></MainguardPinnedThumbprints>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MainguardPinnedThumbprints" Value="$(MainguardPinnedThumbprints)" />
  </ItemGroup>

  <!-- Step 2a (ADR-0001): the pure git engine + persistence now lives in Mainguard.Git; Mainguard.Agents
       keeps the agent platform (orchestration, bootstrap, adapters, daemon, sandbox, terminal) and references
       the git-engine leaf. Docker.DotNet + Porta.Pty stay here (agents/daemon only); LibGit2Sharp / EF /
       DiffPlex / DataProtection moved to Mainguard.Git and reach this project transitively via the project ref. -->
  <ItemGroup>
    <ProjectReference Include="..\Mainguard.Git\Mainguard.Git.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- P2-07: daemon-side container control. NEVER referenced from the shell (Mainguard.App.Shell) (G-18/ESC-I2). -->
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- P2-07 single source of truth: the checked-in hardened seccomp profile the daemon passes to
         CreateContainerAsync IS the same file the agent-base image documents. What the test asserts
         equals what the container runs. -->
    <EmbeddedResource Include="..\images\mainguard-agent-base\seccomp.json">
      <LogicalName>Mainguard.Agents.Agents.Sandbox.seccomp.json</LogicalName>
    </EmbeddedResource>
    <!-- The bundled starter adapter channel (P2-22 §J-5): the pinned + hashed agent CLIs the user
         chooses from during OOBE. Embedded so CLI selection works with no hosted channel; a hosted
         channel later serves the same schema and refreshes the cache over this. -->
    <EmbeddedResource Include="Agents\Adapters\adapters.starter.json">
      <LogicalName>Mainguard.Agents.Agents.Adapters.adapters.starter.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
