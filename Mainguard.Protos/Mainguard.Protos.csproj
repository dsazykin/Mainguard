<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Declared to match Mainguard.Server's set: this project sits in the daemon's publish graph,
         and a RID'd restore of that graph evaluates it under the RID — with no declaration here the
         lockfile's recorded runtimes flapped per machine (WSL added linux-x64, a Mac adds osx-arm64)
         and a RID-less locked-mode restore then failed NU1004. Declaring the full set makes every
         restore evaluate identically, so the committed lockfile is stable on all three platforms. -->
    <RuntimeIdentifiers>linux-x64;win-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>Mainguard.Protos</AssemblyName>
    <RootNamespace>Mainguard.Protos</RootNamespace>
  </PropertyGroup>

  <!-- Proto-first codegen. GrpcServices="Both" so the one shared assembly gives
       the Server its service bases and the App/Tests their client stubs. -->
  <ItemGroup>
    <Protobuf Include="protos/**/*.proto" GrpcServices="Both" ProtoRoot="protos" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    linux-arm64 only: grpc.tools' arm64 protoc segfaults parsing @response-files (exit 139;
    reproduced on 2.71.0 AND 2.76.0 with a one-line rsp), and MSBuild's ProtoCompile always
    passes one — so every gRPC codegen inside an arm64 jail (the macos-host substrate's
    .mainguard/verify) died before compiling a single proto. The generated launcher runs
    build/protoc-argfile-shim.sh, which expands the rsp and execs the REAL protoc with plain
    argv. Hooked after Protobuf_ResolvePlatform because that is where the real path is computed;
    every other platform never enters this target and runs protoc untouched.
  -->
  <Target Name="MainguardShimArm64Protoc" AfterTargets="Protobuf_ResolvePlatform"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
    <PropertyGroup>
      <_MainguardRealProtoc>$(Protobuf_ProtocFullPath)</_MainguardRealProtoc>
      <_MainguardProtocLauncher>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)protoc-launcher.sh'))</_MainguardProtocLauncher>
      <_MainguardProtocShim>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../build/protoc-argfile-shim.sh'))</_MainguardProtocShim>
    </PropertyGroup>
    <WriteLinesToFile File="$(_MainguardProtocLauncher)" Overwrite="true"
                      Lines="#!/bin/sh;exec /bin/sh &quot;$(_MainguardProtocShim)&quot; &quot;$(_MainguardRealProtoc)&quot; &quot;$@&quot;" />
    <Exec Command="chmod +x &quot;$(_MainguardProtocLauncher)&quot;" />
    <PropertyGroup>
      <Protobuf_ProtocFullPath>$(_MainguardProtocLauncher)</Protobuf_ProtocFullPath>
    </PropertyGroup>
  </Target>

</Project>
