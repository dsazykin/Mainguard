<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
             xmlns:views="using:Mainguard.Agents.UI.Views"
             x:Class="Mainguard.Agents.UI.Views.ControlCenterView"
             x:DataType="vm:ControlCenterViewModel">

  <UserControl.Styles>
    <!-- The panel seams. Rest state is the same BorderHairline the other seven GridSplitters in the
         shell draw; pointer-over / drag / keyboard-focus lift it to the accent so the boundary
         ANNOUNCES that it can be dragged (the reported bug was not just "it doesn't resize" but
         "there is no handle to grab"). Both ends are DynamicResource tokens that exist in all five
         themes, so Daylight Loom — a LIGHT theme — gets the same visible seam as the dark ones
         instead of a handle that vanishes into the panel. -->
    <Style Selector="GridSplitter.PanelSeam">
      <Setter Property="Background" Value="{DynamicResource BorderHairline}"/>
      <!-- Focusable so the seam is reachable by Tab; GridSplitter drives KeyboardIncrement off arrow keys. -->
      <Setter Property="Focusable" Value="True"/>
    </Style>
    <Style Selector="GridSplitter.PanelSeam:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="GridSplitter.PanelSeam:pressed">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="GridSplitter.PanelSeam:focus">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- The coordinator surface hosted inside MainWindow's content area (revised design,
       2026-07-11): the section rail picks WHAT is focused (coordinator vs an agent); the
       workspace layout preset picks HOW it is arranged — Flight Deck (queue rail right,
       chat as the coordinator's center content) or Conversation Deck (chat pinned left).
       The layout applies to this surface only; the Repo viewer is untouched. -->

  <Grid RowDefinitions="Auto,*" Margin="8">

    <!-- freeze banner: Still, full strength from frame one (D5) -->
    <Border Grid.Row="0" IsVisible="{Binding IsFrozen}" Background="{DynamicResource SurfaceCard}"
            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8"
            Padding="12,6" Margin="0,0,0,8">
      <StackPanel Spacing="2">
        <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}"
                   Text="All agents paused. The merge queue is frozen. Nothing was lost — resume when ready."/>
        <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Text="{Binding FreezeBannerText}"/>
      </StackPanel>
    </Border>

    <!-- Column 2 used to be a literal 8px gap and column 3 a hard-coded 300px, so EVERY extra pixel
         of window width went to the center pane and the merge queue stayed 300px forever — the
         reported "window extended, still can't see the text". Column 3 is proportional now (it grows
         with the window, bounded so it never eats the terminal or shrinks to nothing) and column 2 is
         a real GridSplitter, so the boundary can also be dragged. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="3*" MinWidth="320"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="280" MaxWidth="640"/>
      </Grid.ColumnDefinitions>

      <!-- The coordinator is driven from its own inline terminal now (not a bespoke chat panel); the
           CoordinatorPanelView / ICoordinatorService plumbing is kept for a possible future surface but
           is no longer rendered here. Column 0 stays in the grid for the layout but hosts nothing. -->

      <!-- center content: what the section rail focused.

           Named because the plan gate's MAXIMUM height is now a share of THIS border rather than a
           constant (see the gate row below). This border's height is decided by the window and the grid
           around it — never by the gate inside it — so capping a child against it cannot feed back into
           its own measure. -->
      <Border Grid.Column="1" x:Name="CoordinatorPane"
              Background="{DynamicResource SurfacePanel}" CornerRadius="12"
              BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
        <Panel>
          <Panel IsVisible="{Binding IsCoordinatorFocus}">
            <!-- The coordinator surface is now just the built-in terminal (the normal CLI interface) plus
                 a Start / Stop / Restart toolbar. Start spawns a REAL CLI in its own hardened jail and its
                 interactive terminal appears below; that terminal is how you talk to it (and where CLI login
                 happens when no key is stored). -->
            <Grid Margin="10">
              <Grid.RowDefinitions>
                <!-- header -->
                <RowDefinition Height="Auto"/>
                <!-- THE PLAN GATE. Auto so an idle gate costs nothing, capped at a SHARE of the pane so
                     the cap grows when the window does. See the block comment on the gate itself. -->
                <RowDefinition Height="Auto"
                               MaxHeight="{Binding #CoordinatorPane.Bounds.Height,
                                                   Converter={x:Static FractionConverter.Instance},
                                                   ConverterParameter=0.7}"/>
                <!-- the draggable seam between the decision and the terminal -->
                <RowDefinition Height="Auto"/>
                <!-- the terminal, which keeps a floor so the gate can never take the whole pane -->
                <RowDefinition Height="*" MinHeight="120"/>
              </Grid.RowDefinitions>

              <!-- header + lifecycle controls -->
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="Coordinator" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                             Text="Runs an installed agent CLI in its own sandbox. Talk to it in the terminal below; it spawns sub-agents through Mainguard, and they appear in the agent list."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox MinWidth="200" FontSize="12" VerticalAlignment="Center"
                            IsVisible="{Binding CanStartCoordinator}"
                            ItemsSource="{Binding InstalledClis}" SelectedItem="{Binding SelectedCli}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Classes="Mono" Text="{Binding Display}" FontSize="12"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Classes="Primary" Content="Start coordinator" FontSize="12"
                          IsVisible="{Binding CanStartCoordinator}"
                          Command="{Binding StartCoordinatorCommand}"
                          IsEnabled="{Binding !IsStartingCoordinator}"/>
                  <Button Classes="Secondary" Content="Restart" FontSize="12"
                          IsVisible="{Binding IsCoordinatorLive}"
                          Command="{Binding RestartCoordinatorCommand}"
                          IsEnabled="{Binding !IsStartingCoordinator}"/>
                  <!-- Reachable even mid-launch (ShowStopCoordinator covers starting/connecting), so a
                       startup that never returns can still be cancelled — the escape hatch from the loader. -->
                  <Button Classes="Danger" Content="Stop coordinator" FontSize="12"
                          IsVisible="{Binding ShowStopCoordinator}"
                          Command="{Binding StopCoordinatorCommand}"
                          IsEnabled="{Binding !IsStoppingCoordinator}"/>
                  <!-- The standing route to the sandbox egress allowlist. Reachable at rest, not only
                       after something has already been blocked — the policy is worth reading before it
                       kills a CLI, and the block prompt is a bad place to discover it exists. -->
                  <Button Classes="Secondary" Content="Network…" FontSize="12"
                          ToolTip.Tip="Agent network allowlist — the hosts agents may reach"
                          Command="{Binding OpenEgressAllowlistCommand}"/>
                </StackPanel>
              </Grid>

              <!-- THE PLAN GATE (phase 2, contract §2). This is the human half of the loop: each worker
                   writes its own plan and STOPS until this is decided.

                   It lives here, above the coordinator's terminal, rather than in the right rail or inside
                   the (no longer rendered) chat panel, for one reason: the state it exists to explain is a
                   silence in THIS pane. A worker held at the gate keeps its jail and its slot against the
                   worker cap, so a full cap of blocked workers means the coordinator has stopped spawning
                   — and the operator watching for that is watching this terminal, where nothing is
                   happening and nothing says why. The decision and the explanation for the silence belong
                   in the same field of view. The merge queue on the right is the wrong home: that rail is
                   work already done, and approval is the gate BEFORE work starts.

                   The region costs nothing when idle: HasGateContent collapses it entirely unless a plan,
                   an escalation or a backpressure sentence is waiting, and it scrolls so a saturated cap's
                   six cards scroll rather than squeezing the terminal off the surface.

                   HOW BIG IT IS ALLOWED TO GET — the fix for the defect that made Approve/Reject a
                   four-point target. This region used to be capped by a literal `MaxHeight="360"`. A
                   constant cap does not move when the window does, so enlarging the window bought the gate
                   nothing and the overflow was cut at the same pixel either way; and because the decision
                   buttons are the LAST row of every card, what a bottom-clip removes is always the
                   decision. Measured on the headless harness: with an escalated card above a blocked one,
                   the second card's Approve had exactly zero visible pixels at 1296x759 AND at 1700x1050.

                   Three things changed, and each of them is load-bearing:
                     · the cap is now a SHARE of the pane (the row's MaxHeight above), so it grows with the
                       window instead of staying at 360 forever;
                     · the seam below is a real GridSplitter, so the split is the human's to move — the
                       previous surface offered no way at all to give the gate more room;
                     · AllowAutoHide is off, so an overflowing gate SAYS it has more below rather than
                       ending in a silent cut with a scrollbar that only appears once you already guessed
                       to point at it.
                   PlanGateView additionally orders decidable cards ABOVE non-actionable escalated ones,
                   so what a clip can reach first is the card with no button on it. -->
              <ScrollViewer Grid.Row="1" Margin="0,0,0,8"
                            IsVisible="{Binding Coordinator.HasGateContent}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            AllowAutoHide="False">
                <views:PlanGateView DataContext="{Binding Coordinator}"/>
              </ScrollViewer>

              <!-- The seam. Present only while the gate is, so an idle coordinator surface is unchanged;
                   it uses the same PanelSeam styling as the shell's other splitters, so it announces on
                   hover/focus that the boundary is draggable. -->
              <GridSplitter Grid.Row="2" x:Name="GateSeam" Classes="PanelSeam" Height="5" Margin="0,0,0,6"
                            ResizeDirection="Rows" HorizontalAlignment="Stretch"
                            IsVisible="{Binding Coordinator.HasGateContent}"/>

              <!-- body: the built-in terminal once a coordinator exists; otherwise the start explainer -->
              <Border Grid.Row="3" Background="{DynamicResource SurfaceCard}" CornerRadius="8" ClipToBounds="True"
                      BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
                <Panel>
                  <!-- coordinator exists (live or dead) → its interactive terminal, or a placeholder
                       until the sandbox PTY attaches (and on the design harness, which has no daemon) -->
                  <Panel IsVisible="{Binding ShowCoordinatorTerminal}">
                    <ContentControl Content="{Binding CoordinatorTerminal}"/>
                    <!-- a dead coordinator's exit reason, so a death that produced no output isn't a silent
                         revert to the start card (an egress block additionally raises the unblock prompt) -->
                    <Border VerticalAlignment="Top" Margin="10" Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource SurfaceDeep}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                            IsVisible="{Binding CoordinatorDeadReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding CoordinatorDeadReason, StringFormat='Coordinator ended — {0}'}"
                                 FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                  </Panel>

                  <!-- no coordinator yet → the start explainer + honest error line -->
                  <StackPanel IsVisible="{Binding !ShowCoordinatorTerminal}" Spacing="8" MaxWidth="440"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No coordinator running" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="A coordinator runs one of your installed agent CLIs in its own sandbox. Start one to talk to it here in its terminal."/>
                    <TextBlock Text="Starting the coordinator sandbox…" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"
                               IsVisible="{Binding IsStartingCoordinator}"/>
                    <TextBlock Text="{Binding CoordinatorStartError}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}"
                               IsVisible="{Binding CoordinatorStartError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- loading animation: covers the area while the coordinator is spawning / its CLI is still
                       starting up, instead of a blank pane; cleared on the terminal's first drawn frame -->
                  <Border IsVisible="{Binding IsCoordinatorConnecting}" Background="{DynamicResource SurfaceCard}">
                    <Panel>
                      <!-- normal: still within the connect budget -->
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="380"
                                  IsVisible="{Binding !CoordinatorConnectTimedOut}">
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" MinHeight="4"
                                     Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource SurfaceDeep}"/>
                        <TextBlock Text="Starting the coordinator…" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <!-- The generic explainer, shown only while the daemon has said nothing specific. -->
                        <TextBlock Text="Launching its sandbox and connecting the CLI." FontSize="11"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   IsVisible="{Binding !HasCoordinatorStartDetail}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                        <!-- …replaced by what the daemon is ACTUALLY doing as soon as it tells us. Today
                             that is the per-repo toolchain image build, the one launch step that runs for
                             minutes; before this line existed the surface had nothing to show for it and
                             fell through to "the coordinator isn't responding". -->
                        <TextBlock Text="{Binding CoordinatorStartDetail}" FontSize="11"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   IsVisible="{Binding HasCoordinatorStartDetail}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                      </StackPanel>

                      <!-- stalled: outlasted the connect budget with no first frame and no death — the honest
                           end of the old "loads forever" trap.

                           The copy DELIBERATELY no longer recommends Stop. The 45s budget expires long
                           before a first-run toolchain image build finishes (the daemon logs
                           `toolchain build begin: … ids=dotnet-10`; that build is ~2.9 GB and runs for
                           minutes INSIDE the spawn call), so the old advice — "Use Stop to cancel and try
                           again" — was offered precisely when following it destroyed the build that was
                           about to unblock the coordinator, and the next attempt started the same build
                           over. Same shape as the sandbox-image loop closed in PR #300, where the offered
                           recovery guaranteed the failure repeated.

                           This is a STOPGAP, not the fix: the UI still cannot distinguish "building" from
                           "hung" because the daemon's build progress never crosses the gRPC boundary. The
                           real fix is to publish that state as a coordinator delta and show it as
                           progress; it needs a daemon-side protocol change and is tracked separately.
                           Until then the honest thing is to describe both possibilities and NOT to
                           recommend the destructive one. Stop stays reachable above for a real hang. -->
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="440"
                                  IsVisible="{Binding CoordinatorConnectTimedOut}">
                        <!-- (a) the daemon has NOT yet said this coordinator finished starting — the
                             toolchain-build case above. -->
                        <StackPanel Spacing="10" IsVisible="{Binding !CoordinatorHasStarted}">
                          <TextBlock Text="Still starting the coordinator" FontSize="14" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                          <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource TextMuted}"
                                     Text="Its sandbox has been starting for a while without drawing a terminal. The first start for a repository also builds its toolchain image, which takes several minutes — leave Mainguard running and it should come up on its own. Stopping now cancels that build and the next attempt starts it over. If it never comes up, check the daemon logs (oobe.log)."/>
                        </StackPanel>

                        <!-- (b) ISSUES-LOG #23: the daemon says this coordinator is RUNNING and its terminal
                             still drew nothing. Telling the user it is "still starting" here is simply
                             false, and it hid the one recovery that works. The usual cause is a daemon
                             restart under a surviving jail: the CLI keeps running inside its sandbox, but
                             the terminal that was attached to it belonged to the previous daemon process
                             and cannot be re-bound (there is no re-attach for a `docker exec` whose client
                             is gone). Restart is offered right here because the header button is the only
                             other route to it and nothing on this card pointed at it. -->
                        <StackPanel Spacing="10" IsVisible="{Binding CoordinatorHasStarted}">
                          <TextBlock Text="The coordinator is running — its terminal isn't attached"
                                     FontSize="14" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                          <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource TextMuted}"
                                     Text="Mainguard's daemon still reports this coordinator's sandbox as running, but nothing is drawing in its terminal. That happens when the daemon restarted while the coordinator kept running: the CLI is alive inside its sandbox, but the terminal it was started with belonged to the old daemon and can't be reconnected. Restart gives you a fresh coordinator you can talk to; the old sandbox is torn down with it."/>
                          <Button Classes="Primary" Content="Restart the coordinator" FontSize="12"
                                  HorizontalAlignment="Center"
                                  Command="{Binding RestartCoordinatorCommand}"
                                  IsEnabled="{Binding !IsStartingCoordinator}"/>
                        </StackPanel>
                      </StackPanel>
                    </Panel>
                  </Border>
                </Panel>
              </Border>
            </Grid>
          </Panel>
          <Panel IsVisible="{Binding !IsCoordinatorFocus}">
            <!-- P2-13 #6: the per-agent dock workspace host (Terminal + agent-diff + staging), reused across
                 agent selections. Its primary pane is the live terminal (#5) attached to the agent's PTY.
                 Rendered via the ContentControl → ViewLocator so IsVisible stays in this VM's data context. -->
            <ContentControl Content="{Binding Workspace}"/>
            <TextBlock Text="Select an agent from the sidebar to open its workspace."
                       FontSize="13" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding Workspace, Converter={x:Static ObjectConverters.IsNull}}"/>
          </Panel>
        </Panel>
      </Border>

      <!-- the terminal ↔ merge-queue seam -->
      <GridSplitter Grid.Column="2" Classes="PanelSeam" Width="6" Margin="1,0"
                    ResizeDirection="Columns" Cursor="SizeWestEast"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

      <!-- right rail: the merge queue (+ telemetry beneath it on Flight Deck) -->
      <Grid Grid.Column="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="160"/>
          <RowDefinition Height="Auto"/>
          <!-- the telemetry row; resized by TelemetrySeam, collapsed by the code-behind when hidden -->
          <RowDefinition Height="Auto"/>
          <!-- the dev-only seeding card; the row is zero unless the daemon enabled seeding -->
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" MinHeight="160" Background="{DynamicResource SurfacePanel}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
          <views:QueueRailView DataContext="{Binding Queue}"/>
        </Border>
        <!-- the queue ↔ telemetry seam. Same class of bug as the column above: telemetry was pinned at
             Height="240" with no way to give the queue more room on a short window. The row starts Auto,
             so the card's MinHeight sets the resting size and a hidden card collapses the row to zero;
             the splitter then takes over. NOTE the row only STAYS Auto until the first drag — after that
             the splitter has rewritten it to pixels, and the collapse-on-hide is maintained by
             ControlCenterView.axaml.cs, not by this markup. -->
        <GridSplitter Grid.Row="1" x:Name="TelemetrySeam" Classes="PanelSeam" Height="6" Margin="0,4"
                      ResizeDirection="Rows" Cursor="SizeNorthSouth"
                      IsVisible="{Binding IsFlightDeck}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        <Border Grid.Row="2" x:Name="TelemetryCard" MinHeight="180" MaxHeight="560" IsVisible="{Binding IsFlightDeck}"
                Background="{DynamicResource SurfacePanel}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
          <views:TelemetryPanelView DataContext="{Binding Telemetry}"/>
        </Border>
        <!-- DEV-ONLY queue seeding (docs/design/queue-seeding.md): the card EXISTS only when the
             daemon answered the availability probe — a daemon without the boot flag never maps the
             service, QueueSeeding stays null, and this row collapses to nothing. -->
        <Border Grid.Row="3" Margin="0,8,0,0"
                IsVisible="{Binding QueueSeeding, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource SurfacePanel}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
          <views:QueueSeedingPanelView DataContext="{Binding QueueSeeding}"/>
        </Border>
      </Grid>
    </Grid>

    <!-- P2-47 #7: the review cockpit overlay — built from the live GetMergeDiff RPC. Shown when the merge
         rail's "review" action resolves a real branch-vs-main diff; dismissable back to the surface. -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
            IsVisible="{Binding ReviewCockpit, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Margin="24" Background="{DynamicResource SurfacePanel}" CornerRadius="12"
              BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,8">
            <TextBlock Grid.Column="0" Text="Review" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Classes="Secondary" Padding="12,4"
                    Command="{Binding CloseReviewCommand}"/>
          </Grid>
          <views:ReviewCockpitView Grid.Row="1" DataContext="{Binding ReviewCockpit}"/>
        </Grid>
      </Border>
    </Border>

    <!-- Fix 2: egress block-notification prompt — an agent CLI died on a host the default-deny sandbox
         proxy refused. Names what was blocked + which agent needed it; Unblock adds it to the allowlist
         and retries, Keep blocked leaves the policy as-is (the safe default). -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
            IsVisible="{Binding EgressBlockPrompt, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{DynamicResource SurfacePanel}" CornerRadius="12" Padding="20"
              BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1"
              DataContext="{Binding EgressBlockPrompt}" x:DataType="vm:EgressBlockPromptViewModel">
        <StackPanel Spacing="12">
          <TextBlock Text="Blocked by the sandbox" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimary}"/>
          <Border Background="{DynamicResource SurfaceDeep}" CornerRadius="6" Padding="8,6">
            <TextBlock Classes="Mono" Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
          </Border>
          <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                     Text="Unblock adds it to the egress allowlist and retries. Keep blocked leaves the default-deny policy as-is."/>
          <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningBrush}"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <!-- Unblock can only ever add the ONE host parsed out of the death message. When that is
                 not enough (two hosts, or a mis-parse), this is the way to the full list. -->
            <Button Classes="Secondary" Content="Manage allowlist…" FontSize="12"
                    IsVisible="{Binding CanManageAllowlist}"
                    Command="{Binding ManageAllowlistCommand}" IsEnabled="{Binding !IsBusy}"/>
            <Button Classes="Secondary" Content="Keep blocked" FontSize="12"
                    Command="{Binding KeepBlockedCommand}" IsEnabled="{Binding !IsBusy}"/>
            <Button Classes="Primary" Content="Unblock and retry" FontSize="12"
                    Command="{Binding UnblockCommand}" IsEnabled="{Binding !IsBusy}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Confirm-before-stop: stopping fully terminates the coordinator's CLI + sandbox and cancels a
         launch still in progress, so it asks first. The busy spinner holds while the daemon tears down. -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
            IsVisible="{Binding StopPrompt, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{DynamicResource SurfacePanel}" CornerRadius="12" Padding="20"
              BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1"
              DataContext="{Binding StopPrompt}" x:DataType="vm:CoordinatorStopPromptViewModel">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}"/>
          <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimary}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="Secondary" Content="Keep running" FontSize="12"
                    Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}"/>
            <Button Classes="Danger" Content="{Binding ConfirmLabel}" FontSize="12"
                    Command="{Binding ConfirmCommand}" IsEnabled="{Binding !IsBusy}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
