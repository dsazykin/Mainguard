<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
             x:Class="Mainguard.Agents.UI.Views.PlanGateView"
             x:DataType="vm:CoordinatorPanelViewModel">

  <!-- The phase-2 plan gate as a STANDALONE surface (contract §2 / ControlCenterDesign.md §5.2).

       Why this is its own control rather than markup inside one panel: the coordinator conversation now
       happens in a real PTY, and a PTY cannot render a button. The gate is therefore the one part of the
       old chat panel that has to survive independently of the chat — it is a decision about a WORKER,
       taken out of band from whatever the coordinator is saying. Splitting it out lets the shipped
       Control Center host the decisions above the terminal while CoordinatorPanelView keeps hosting them
       inside the (unrendered) conversation, from a single definition of the card.

       Three states, each otherwise silent:
         · backpressure  — blocked workers filled the worker cap, so the coordinator has STOPPED spawning.
                           Indistinguishable from a hang unless this says so; the sentence is the daemon's
                           own, not re-derived, so the number that refuses the spawn is the number read.
         · escalated     — the revision budget is spent and the worker stopped. Deliberately no button.
         · pending       — one card PER BLOCKED WORKER, with Scope and Approach, Approve, and Reject
                           carrying feedback the worker revises against. -->

  <StackPanel Spacing="8">

    <!-- The legible stall. Bordered and named when the cap is saturated by blocked plans, because at that
         point it is not a status line — it is the explanation for why nothing is happening. -->
    <Border Classes="Card" Padding="10,8" CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource WarningBrush}"
            IsVisible="{Binding BackpressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Spacing="3">
        <TextBlock Text="The coordinator has stopped spawning — it is waiting on you"
                   FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}"
                   IsVisible="{Binding IsCapSaturatedByBlockedWorkers}"/>
        <TextBlock Text="{Binding BackpressureText}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}"/>
        <TextBlock Text="{Binding PressureText}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMuted}"
                   IsVisible="{Binding PressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <!-- Escalated workers: the revision budget is spent, so there is deliberately no decision button.
         The loop is over; what is left is a human choosing to steer the worker or end it. -->
    <ItemsControl ItemsSource="{Binding EscalatedPlans}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:EscalatedPlanViewModel">
          <Border Classes="Card" Padding="10" Margin="0,0,0,6" CornerRadius="8"
                  BorderThickness="1" BorderBrush="{DynamicResource DangerBrush}">
            <StackPanel Spacing="4">
              <TextBlock Text="Escalated to you" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource DangerBrush}"/>
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding HeadlineText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="{Binding LastFeedbackText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMuted}"
                         IsVisible="{Binding HasLastFeedback}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- One worker-authored plan card per blocked worker. Scope is the load-bearing field (§5.2): it is
         what the human is actually consenting to, and it is the field that proves the worker read the
         repository rather than guessed at it. -->
    <ItemsControl ItemsSource="{Binding PendingPlans}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PlanCardViewModel">
          <Border Classes="Card" Padding="10" Margin="0,0,0,6" CornerRadius="8"
                  BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Column="1" Text="{Binding RevisionText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding IsRevision}"/>
              </Grid>
              <TextBlock Text="{Binding RevisedAgainstText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMuted}"
                         IsVisible="{Binding HasFeedbackHistory}"/>
              <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Scope" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="Mono" Text="{Binding ScopeText}" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Approach" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Approach}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Test" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TestStrategy}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
              </Grid>
              <TextBlock Text="{Binding FactsText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMuted}"/>

              <!-- Rejection is feedback, not death: what is typed here is delivered to the worker, which
                   revises against it and presents again. An empty box costs a round of the budget. -->
              <TextBox Text="{Binding FeedbackText}" FontSize="11" AcceptsReturn="True" MaxHeight="72"
                       Watermark="What should the worker change? This text goes back to it."/>
              <TextBlock Text="This is the last revision — rejecting again stops the worker and escalates to you."
                         FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                         IsVisible="{Binding NextRejectionEscalates}"/>

              <!-- A decision that did not land says so here. Without this the card is indistinguishable
                   from a card whose approval worked, and the human waits on a worker still blocked. -->
              <TextBlock Text="{Binding DecisionErrorText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerBrush}"
                         IsVisible="{Binding HasDecisionError}"/>

              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Secondary" Content="{Binding RejectButtonText}" FontSize="12"
                        Command="{Binding RejectCommand}" IsEnabled="{Binding !IsDeciding}"/>
                <!-- Approve is the panel's one accent: it is the product thesis, and it is not destructive. -->
                <Button Classes="Accent" Content="Approve plan" FontSize="12"
                        Command="{Binding ApproveCommand}" IsEnabled="{Binding !IsDeciding}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
