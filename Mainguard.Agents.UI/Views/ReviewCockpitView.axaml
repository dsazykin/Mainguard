<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
             xmlns:conv="using:Mainguard.Agents.UI.Converters"
             xmlns:model="using:Mainguard.Git.Models"
             x:Class="Mainguard.Agents.UI.Views.ReviewCockpitView"
             x:DataType="vm:ReviewCockpitViewModel">

  <!-- The P2-11 Review Cockpit (ControlCenterDesign §6) — where trust is manufactured. Risk-ranked hunk
       list (ordering only, nothing hidden), per-hunk provenance chips, the pinned item-by-item flagged
       gate, and the test-delta strip. No rule logic here: the ViewModel renders pure-Core classifications.
       Design tokens / component classes only; no raw colors; renders in all five themes. -->

  <UserControl.Styles>
    <Style Selector="PathIcon.sev"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/></Style>
    <Style Selector="PathIcon.sev.mustAck"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
    <Style Selector="PathIcon.sev.risky"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
    <Style Selector="PathIcon.sev.info"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/></Style>
    <Style Selector="Border.diffAdd"><Setter Property="Background" Value="{DynamicResource DiffAddedBg}"/></Style>
    <Style Selector="Border.diffDel"><Setter Property="Background" Value="{DynamicResource DiffRemovedBg}"/></Style>
    <!-- The declaration line reads muted when the worker asserted it followed the approach, and takes the
         Warning role when it declared a departure or said nothing at all. Two roles, by meaning — the
         merge is gated by the flagged panel below, never by this line. -->
    <Style Selector="TextBlock.declaration"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/></Style>
    <Style Selector="TextBlock.declaration.attention"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="12">

    <!-- Header facts -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Classes="Mono" Text="{Binding VerifiedText}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                 IsVisible="{Binding VerifiedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- What the human APPROVED — the other half of a review (above the diff, on purpose).

         This surface used to show the diff and nothing to compare it against: the approved `approach`
         was written by the worker, read once by the human at approval, and then never rendered again.
         Measured consequence — an approved approach said the module had no validation idiom and the
         plan would keep plain `a / b`; the branch shipped a throwing validation layer that changed
         three pre-existing functions. The flagged list was EMPTY (the file scope was honoured) and the
         verification was green (the worker wrote the tests). Nothing was wrong with the gates; the
         reviewer simply had only one side of the comparison in front of them.

         Not rendered at all when there is no approved plan — an empty "approved approach" card would
         assert an approval a manual agent or an external PR never had. -->
    <Border Grid.Row="1" Padding="8" Margin="0,0,0,8" CornerRadius="8"
            Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1"
            IsVisible="{Binding HasApprovedApproach}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding ApprovedPlanHeading}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
        <!-- The approach verbatim. Scrolls rather than truncating: an elided approach is worse than
             none, because the sentence that was cut is exactly the one the diff disagrees with. -->
        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding ApprovedApproachText}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimary}"/>
        </ScrollViewer>
        <TextBlock Classes="declaration" Classes.attention="{Binding DeviationNeedsAttention}"
                   Text="{Binding DeviationDeclarationText}" FontSize="10" TextWrapping="Wrap"
                   IsVisible="{Binding DeviationDeclarationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <!-- Test-delta strip (§6.5) -->
    <Border Grid.Row="2" Padding="8,4" Margin="0,0,0,8" CornerRadius="6"
            Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1"
            IsVisible="{Binding TestDeltaSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding TestDeltaSummary}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
    </Border>

    <!-- The flagged gate panel (§6.3), pinned above the hunk list -->
    <Border Grid.Row="3" Padding="8" Margin="0,0,0,8" CornerRadius="8"
            Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
            IsVisible="{Binding FlaggedPanel.HasItems}">
      <StackPanel Spacing="6" DataContext="{Binding FlaggedPanel}" x:DataType="vm:FlaggedChangesPanelViewModel">
        <TextBlock Text="FLAGGED — acknowledge each to enable merge" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource DangerBrush}"/>
        <!-- Named separately because it is a different kind of claim from everything else in this
             panel: the other rows are what the daemon found in the diff, these are what the worker
             SAID about its own work — unverifiable by construction, and to be read against the
             approved approach above rather than against the file the row names. -->
        <TextBlock Text="{Binding DeviationHeading}" FontSize="10" FontWeight="SemiBold"
                   Foreground="{DynamicResource WarningBrush}"
                   IsVisible="{Binding DeviationHeading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding ResetNotice}" FontSize="10" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ResetNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <!-- Acknowledging cannot reach the gate right now (no repo / no daemon): said plainly, and the
             per-row controls are disabled, rather than drawing checkmarks that clear nothing. -->
        <TextBlock Text="{Binding UnavailableNotice}" FontSize="10" Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap" IsVisible="{Binding HasUnavailableNotice}"/>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FlaggedItemRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                <PathIcon Grid.Row="0" Grid.Column="0" Classes="sev mustAck" VerticalAlignment="Center" Margin="0,0,6,0"
                          Data="{Binding SeverityGlyphKey, Converter={x:Static ResourceKeyToGeometryConverter.Instance}}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Path}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                  <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="2" Classes="Secondary" FontSize="10" Padding="8,2" VerticalAlignment="Center"
                        Command="{Binding AcknowledgeCommand}"
                        Content="{Binding AckLabel}"
                        IsEnabled="{Binding CanAck}"
                        ToolTip.Tip="{Binding AckTooltip}"/>
                <!-- The gate's own refusal, verbatim: an acknowledgment that did not take says so here
                     instead of the row quietly reading as cleared. -->
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AckNotice}" FontSize="10"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                           IsVisible="{Binding HasAckNotice}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Ranked hunks (left) + diff readout (right) -->
    <Grid Grid.Row="4" ColumnDefinitions="0.9*,1.1*">
      <Border Grid.Column="0" Margin="0,0,4,0" CornerRadius="8" Background="{DynamicResource SurfaceCard}"
              BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
        <ScrollViewer>
          <StackPanel Margin="6">
            <TextBlock Text="Nothing awaiting review." FontSize="12" Foreground="{DynamicResource TextMuted}"
                       IsVisible="{Binding IsEmpty}"/>
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReviewFileRowViewModel">
                  <StackPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="sev" Classes.mustAck="{Binding IsMustAck}" Classes.risky="{Binding IsRisky}"
                                Classes.info="{Binding IsInformational}" VerticalAlignment="Center"
                                Data="{Binding SeverityGlyphKey, Converter={x:Static ResourceKeyToGeometryConverter.Instance}}"/>
                      <TextBlock Text="{Binding Path}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                      <TextBlock Text="{Binding CategoryWord}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Hunks}" Margin="18,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewHunkRowViewModel">
                          <Border Classes="RefChipGhost" Padding="4,1" Margin="0,1"
                                  IsVisible="{Binding HasProvenance}">
                            <TextBlock Classes="Mono" Text="{Binding ProvenanceChip}" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" ToolTip.Tip="{Binding ProvenanceTooltip}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Diff readout: the shipped diff tints over the ranked hunks (composed, not recomputed). -->
      <Border Grid.Column="1" Margin="4,0,0,0" CornerRadius="8" Background="{DynamicResource SurfaceDeep}"
              BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
        <!-- The one place on this surface that genuinely needs to scroll sideways: diff lines are source
             code, so wrapping them would break the column alignment that makes a diff readable. Without
             this, a long line was simply clipped at the pane edge with no way to reach the rest. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Files}" Margin="4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReviewFileRowViewModel">
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Classes="Mono" Text="{Binding Path}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMuted}" Margin="4,4,0,2"/>
                  <ItemsControl ItemsSource="{Binding Hunks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReviewHunkRowViewModel">
                        <ItemsControl ItemsSource="{Binding Hunk.Lines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:DiffLine">
                              <Border Classes.diffAdd="{Binding Kind, Converter={x:Static conv:DiffLineKindToClassConverter.Add}}"
                                      Classes.diffDel="{Binding Kind, Converter={x:Static conv:DiffLineKindToClassConverter.Delete}}">
                                <TextBlock Classes="Mono" Text="{Binding Text}" FontSize="10"
                                           Foreground="{DynamicResource TextPrimary}"/>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Footer: the CanMerge equation as facts + reject + bring-local + merge (§6.4). Reject is the
         review verdict "no" (terminal) — DangerQuiet, destructive by hue not mass, two-step confirm
         with an optional reason; hidden entirely when the composition has no reject handler. -->
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,8,0,0">
      <TextBlock Grid.Column="0" Text="{Binding MergeReason}" FontSize="11" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                 IsVisible="{Binding !IsConfirmingReject}"/>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                  IsVisible="{Binding IsConfirmingReject}">
        <TextBlock Text="Reject this branch?" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
        <TextBox Text="{Binding RejectReason, Mode=TwoWay}" Watermark="reason (optional)"
                 FontSize="11" MinWidth="180" MaxWidth="300"/>
        <Button Classes="Secondary" Content="Cancel" FontSize="11" Padding="8,2"
                Command="{Binding CancelRejectCommand}"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="DangerQuiet" Content="Reject" FontSize="12" Padding="10,3" Margin="0,0,6,0"
              Command="{Binding RejectCommand}" IsVisible="{Binding CanReject}"
              ToolTip.Tip="Reject this branch in review — terminal; the queue records who and why."/>
      <Button Grid.Column="2" Classes="Secondary" Content="Bring local" FontSize="12" Padding="10,3" Margin="0,0,6,0"
              Command="{Binding BringBranchLocalCommand}"
              ToolTip.Tip="Fetches this agent branch from the sync remote into a local branch — the agent keeps working."/>
      <Button Grid.Column="3" Classes="Accent" Content="Merge" FontSize="12" Padding="12,3"
              Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}"
              ToolTip.Tip="{Binding MergeReason}"/>
    </Grid>
  </Grid>
</UserControl>
