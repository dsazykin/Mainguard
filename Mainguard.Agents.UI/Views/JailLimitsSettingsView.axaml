<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
        x:Class="Mainguard.Agents.UI.Views.JailLimitsSettingsView"
        x:DataType="vm:JailLimitsSettingsViewModel">
    <Border Padding="0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6" ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource ShieldIcon}" Width="18" Height="18"
                          Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="Agent jails" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
            <TextBlock Grid.Row="1" Margin="0,0,0,12" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="Every agent runs in its own sandbox container with a memory and CPU ceiling. The ceiling belongs to the Mainguard daemon — it is what creates each jail — so it is read from and saved to the daemon, and applies to jails started after you save. Lower it on a machine with less memory; raise it for heavy builds."/>

            <!-- Daemon refusal / unreachable -->
            <Border Grid.Row="2" Classes="Card" Background="{DynamicResource SurfaceCard}" CornerRadius="8"
                    Padding="12" Margin="0,0,0,12"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource WarningIcon}" Width="14" Height="14"
                              Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <!-- The ceiling -->
            <Border Grid.Row="3" Classes="Card" Background="{DynamicResource SurfaceCard}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="Per-jail ceiling" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Memory (GiB)" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        <NumericUpDown Minimum="{Binding MinMemoryGiB}" Maximum="{Binding MaxMemoryGiB}" Increment="0.5"
                                       FormatString="0.##" Value="{Binding MemoryGiB}" HorizontalAlignment="Left" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="CPUs" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        <NumericUpDown Minimum="{Binding MinCpus}" Maximum="{Binding MaxCpus}" Increment="0.5"
                                       FormatString="0.##" Value="{Binding Cpus}" HorizontalAlignment="Left" Width="140"/>
                    </StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Text="{Binding FleetNote}"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                               IsVisible="{Binding IsDefault}"
                               Text="The daemon is running the built-in defaults (2 GiB, 2 CPUs)."/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Classes="Primary" Padding="14,6" Command="{Binding SaveCommand}"/>
                        <Button Content="Reload" Classes="Secondary" Padding="14,6" Command="{Binding LoadCommand}"/>
                        <Button Content="Reset to defaults" Classes="Secondary" Padding="14,6" Command="{Binding ResetToDefaultsCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
