<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
             xmlns:controls="using:Mainguard.Agents.UI.Controls"
             x:Class="Mainguard.Agents.UI.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">

  <!-- The terminal surface: the engine renders behind ITerminalView, the ViewModel wires it to the
       daemon stream. The concrete control (interim TerminalControl or the P2-18 TerminalGridControl)
       is chosen by the TerminalEngine flag in code-behind, which only binds it to the ViewModel —
       no terminal/VT logic lives here or there (invariant 3). -->
  <Border Background="{DynamicResource TerminalBackground}" Padding="6">
    <Grid RowDefinitions="Auto,Auto,*">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="2,0,0,6">
        <TextBlock Text="Terminal" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
        <TextBlock Text="{Binding AgentId, StringFormat='agent {0}'}"
                   Classes="Mono" FontSize="12" Foreground="{DynamicResource TextMuted}"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Input that did NOT reach the agent. Never a silent drop: a keystroke typed at a jailed CLI
           that never arrived is both a correctness and a trust problem, and a half-delivered
           instruction is worse than a refused one. Clears itself once input lands again. -->
      <Border Grid.Row="1" Classes="Card" Background="{DynamicResource SurfaceCard}" CornerRadius="8"
              Padding="10" Margin="0,0,0,6"
              IsVisible="{Binding HasInputDeliveryError}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource WarningIcon}" Width="14" Height="14"
                    Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding InputDeliveryError}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource DangerBrush}"/>
        </StackPanel>
      </Border>

      <ContentControl x:Name="TerminalHost" Grid.Row="2"/>
    </Grid>
  </Border>
</UserControl>
