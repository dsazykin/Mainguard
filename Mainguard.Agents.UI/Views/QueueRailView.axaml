<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
             xmlns:conv="using:Mainguard.Agents.UI.Converters"
             x:Class="Mainguard.Agents.UI.Views.QueueRailView"
             x:DataType="vm:QueueRailViewModel">

  <!-- The merge-queue rail (ControlCenterDesign.md §3): the P2-10 state machine as an instrument
       face. State words first (E4/N-3); badges + brushes are second channels; the ONE accent is
       the front-most fresh Verified entry's Review CTA. -->

  <UserControl.Styles>
    <Style Selector="PathIcon.badge"><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/></Style>
    <Style Selector="PathIcon.badge.neutral"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
    <Style Selector="PathIcon.badge.mutedState"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/></Style>
    <Style Selector="PathIcon.badge.infoState"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>
    <Style Selector="PathIcon.badge.warningState"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
    <Style Selector="PathIcon.badge.successState"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Style>
    <Style Selector="PathIcon.badge.dangerState"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="10">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="Merge queue" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
      <!-- "main <sha>" is another identifier that must not lose characters — wrap, don't clip. -->
      <TextBlock Classes="Mono" Text="{Binding MainShaText}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMuted}"/>
    </StackPanel>

    <!-- Horizontal scrolling is DELIBERATELY off. The rail's two long strings are identifiers (a 32-hex
         agent id and its agent/<id> branch) and they now wrap instead of overflowing, which is both
         lossless and readable without a second scrollbar to read a name. Turning the horizontal bar on
         would measure this content at infinite width and therefore SILENTLY DEFEAT that wrapping — it
         would restore the clipping it was meant to cure. Genuinely unwrappable content (diff lines,
         where wrapping destroys column alignment) scrolls sideways in ReviewCockpitView instead. -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Nothing queued." FontSize="12" Foreground="{DynamicResource TextMuted}"
                   IsVisible="{Binding IsEmpty}"/>
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QueueEntryViewModel">
              <Border Padding="8,8" Margin="0,0,0,5" CornerRadius="8"
                      BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
                <StackPanel Spacing="3">
                  <!-- Was a horizontal StackPanel, which gives the name unbounded width and lets it push
                       the state word off the edge: a real 32-hex agent id rendered the row as
                       "<id>  Work…". State words come FIRST in this design (§3, E4/N-3), so the state
                       word gets an Auto column that is measured before the name's star column — it can
                       no longer be the thing that gets clipped. -->
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Reserved 10px badge slot (E3): the slot never reflows -->
                    <Panel Grid.Column="0" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                      <PathIcon Classes="badge"
                                Classes.neutral="{Binding IsNeutral}" Classes.mutedState="{Binding IsMutedState}"
                                Classes.infoState="{Binding IsInfoState}" Classes.warningState="{Binding IsWarningState}"
                                Classes.successState="{Binding IsSuccessState}" Classes.dangerState="{Binding IsDangerState}"
                                Data="{Binding BadgeGeometryKey, Converter={x:Static ResourceKeyToGeometryConverter.Instance}}"/>
                    </Panel>
                    <!-- The name shares its line with the state word, so it trims rather than wraps (a
                         wrapped 32-hex id would make every row three lines tall). Nothing is lost: the
                         tooltip carries the full value, and the Branch line below prints the SAME id in
                         full, wrapped. -->
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="{Binding StateWord}" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                  </Grid>
                  <!-- Identifiers wrap instead of clipping: losing characters off the end of a branch name
                       or a SHA is exactly the case where an ellipsis is useless, because the whole point
                       of reading it is to match it against something else. -->
                  <TextBlock Classes="Mono" Text="{Binding Branch}" FontSize="11" TextWrapping="Wrap"
                             ToolTip.Tip="{Binding Branch}" Foreground="{DynamicResource TextMuted}"/>
                  <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                  <TextBlock Classes="Mono" Text="{Binding VerifiedAgainst}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextMuted}"
                             IsVisible="{Binding VerifiedAgainst, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <!-- The verification trigger. Secondary by role: the rail's ONE accent stays the
                       Review CTA, and asking for a check is a supporting action, not the CTA. -->
                  <TextBlock Text="{Binding VerifyMessage}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding VerifyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="Secondary" Content="{Binding VerifyButtonText}" FontSize="12" Padding="10,3"
                            Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}"
                            ToolTip.Tip="Run this repo's verification command in this agent's own jail."/>
                    <Button Classes="Accent" Content="Review" FontSize="12" Padding="10,3"
                            Command="{Binding OpenReviewCommand}" IsVisible="{Binding ShowReviewAccent}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- The CanMerge gate line (§3.4): the reason renders verbatim -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderHairline}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0"
            IsVisible="{Binding GateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding GateText}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
