<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
             xmlns:uivm="using:Mainguard.UI.ViewModels"
             xmlns:converters="using:Mainguard.Agents.UI.Converters"
             x:Class="Mainguard.Agents.UI.Views.AgentRailView"
             x:DataType="vm:AgentRailViewModel">

  <!-- The Pro agent rail (step 2d): the worker list + the kill switch, extracted verbatim out of
       MainWindow so the shell hosts it as opaque object content (AgentRailContent) through ViewLocator
       instead of naming the Pro rail types. The shell gates the whole thing with ShowsAgentRail, so the
       inner IsVisible=ShowsAgentRail guards are gone (redundant); the collapse-state bindings reach
       IsRailExpanded on MainWindowViewModel through the window, the rail's established escape hatch. The
       railItem base style still lives in MainWindow.axaml (shared with the section rows) and cascades in;
       railBadge/railKill are rail-exclusive, so they live here with their markup. -->

  <UserControl.Styles>
    <!-- The agent micro-badge: colour comes from the ONE AgentStatusBrushConverter (bound on
         the element); the state change cross-fades so a status flip reads as a transition, not
         a jump. Shape (the glyph) is the primary channel, colour the second (E1/E2). -->
    <Style Selector="PathIcon.railBadge">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- The kill switch at the rail's foot: red at rest (feedback 2026-07-11), solid Danger
         fill on hover and while engaged. -->
    <Style Selector="Button.railKill PathIcon"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
    <Style Selector="Button.railKill TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
    <Style Selector="Button.railKill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="Button.railKill:pointerover PathIcon"><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Style>
    <Style Selector="Button.railKill:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Style>
    <Style Selector="Button.railKill.frozen">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="Button.railKill.frozen PathIcon"><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Style>
    <Style Selector="Button.railKill.frozen TextBlock"><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- The agent rail's leading divider (was gated with the rest by ShowsAgentRail; the shell now
         gates the whole view). -->
    <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderHairline}" Margin="4,6"/>

    <!-- the live agent list (tooltips carry state + task); scrolls vertically in both states and
         horizontally when expanded -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel Spacing="2">
        <TextBlock Text="AGENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="8,2,0,4"
                   IsVisible="{Binding $parent[Window].((uivm:IShellRailHost)DataContext).IsRailExpanded}"/>
        <ItemsControl ItemsSource="{Binding Agents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentRowViewModel">
              <!-- Name it explicitly: the row's text is expanded-state only, and Avalonia does not
                   use ToolTip.Tip as an accessible-name fallback, so a collapsed rail row would be
                   an unnamed button to a screen reader. -->
              <Button Classes="railItem" Classes.active="{Binding IsSelected}"
                      Opacity="{Binding RowOpacity}" ToolTip.Tip="{Binding Tooltip}"
                      AutomationProperties.Name="{Binding DisplayName}"
                      Command="{Binding $parent[Window].((uivm:IShellRailHost)DataContext).ShowAgentCommand}"
                      CommandParameter="{Binding AgentId}">
                <!-- The row's actions. Right-clicking an agent previously did nothing at all, so the
                     only reachable per-agent controls were on the Resources tab — a human looking at an
                     agent had no way to act on the agent they were looking at. Ordered by blast radius:
                     navigation, then naming, then review, then the two that end things, with the one
                     that destroys work last and coloured as such. -->
                <Button.ContextMenu>
                  <ContextMenu>
                    <ContextMenu.Styles>
                      <!-- Per-item hover highlight, never the whole box — matching the Resources rows. -->
                      <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                      </Style>
                      <Style Selector="MenuItem"><Setter Property="Padding" Value="12,6"/></Style>
                    </ContextMenu.Styles>
                    <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                    <Separator/>
                    <MenuItem Header="Rename…" Command="{Binding RenameCommand}"/>
                    <MenuItem Header="Reset name" Command="{Binding ResetNameCommand}"/>
                    <Separator/>
                    <MenuItem Header="Review changes…" Command="{Binding ReviewCommand}"/>
                    <MenuItem Header="Verify now" Command="{Binding VerifyCommand}"/>
                    <MenuItem Header="View verification log" Command="{Binding ViewVerificationLogCommand}"/>
                    <Separator/>
                    <MenuItem Header="Copy agent ID" Command="{Binding CopyAgentIdCommand}"/>
                    <MenuItem Header="Copy branch name" Command="{Binding CopyBranchCommand}"/>
                    <Separator/>
                    <MenuItem Header="{Binding PauseMenuLabel}" Command="{Binding PauseOrResumeCommand}"/>
                    <MenuItem Header="End task" Command="{Binding EndCommand}"
                              Foreground="{DynamicResource DangerBrush}"/>
                    <MenuItem Header="Delete agent…" Command="{Binding DeleteCommand}"
                              Foreground="{DynamicResource DangerBrush}"/>
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid ColumnDefinitions="14,*,Auto">
                  <Panel Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                    <PathIcon Classes="railBadge"
                              Foreground="{Binding Status, Converter={x:Static converters:AgentStatusBrushConverter.Instance}}"
                              Data="{Binding BadgeGeometryKey, Converter={x:Static ResourceKeyToGeometryConverter.Instance}}"/>
                  </Panel>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                              IsVisible="{Binding $parent[Window].((uivm:IShellRailHost)DataContext).IsRailExpanded}">
                    <!-- The row's LABEL, not the CLI kind. This used to bind Name — the kind — so every
                         claude-code session rendered the identical word and the rail could not tell four
                         agents apart. DisplayName is the human's name, else the agent's brief, else
                         "Worker 70b21c13". Not Mono any more: two of those three are prose, and a
                         proportional face fits more of a brief in the same rail width. -->
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    <!-- PR3: the orchestration role as a quiet word ("coordinator" / "subagent"), never a color -->
                    <TextBlock Text="{Binding RoleLabel}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" IsVisible="{Binding HasRoleLabel}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="88"/>
                  </StackPanel>
                  <!-- expanded-only "needs you" tag: a quiet word, not a pulse (§2.4). Colour is the
                       status token via the one converter; reads at a glance without decoding the glyph. -->
                  <Border Grid.Column="2" Margin="6,0,2,0" VerticalAlignment="Center" CornerRadius="999"
                          Padding="6,1" Background="{DynamicResource AccentSelection}"
                          IsVisible="{Binding NeedsAttention}">
                    <TextBlock Text="needs you" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding Status, Converter={x:Static converters:AgentStatusBrushConverter.Instance}}"
                               IsVisible="{Binding $parent[Window].((uivm:IShellRailHost)DataContext).IsRailExpanded}"/>
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- the kill switch, at the rail's foot in every section -->
    <Button Grid.Row="2" Classes="railItem railKill" Classes.frozen="{Binding IsFrozen}"
            Command="{Binding ToggleKillSwitchCommand}"
            AutomationProperties.Name="{Binding KillSwitchLabel}"
            ToolTip.Tip="Stop all agents and freeze the merge queue — instant, nothing is lost, resume any time">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="{StaticResource SeverityBlockerIcon}" Width="13" Height="13"/>
        <TextBlock Text="{Binding KillSwitchLabel}" FontSize="12" VerticalAlignment="Center"
                   IsVisible="{Binding $parent[Window].((uivm:IShellRailHost)DataContext).IsRailExpanded}"/>
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
