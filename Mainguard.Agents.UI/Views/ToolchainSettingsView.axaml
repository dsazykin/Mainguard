<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mainguard.Agents.UI.ViewModels"
        xmlns:views="using:Mainguard.Agents.UI.Views"
        x:Class="Mainguard.Agents.UI.Views.ToolchainSettingsView"
        x:DataType="vm:ToolchainSettingsViewModel">
    <Border Padding="0" MaxWidth="620">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                <PathIcon Data="{StaticResource TerminalIcon}" Width="18" Height="18"
                          Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Language toolchains" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Margin="0,0,0,12" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="The languages your repositories can be built and tested in. Each installs at a pinned, checksum-verified version inside the Mainguard environment — never on your own system — and appears read-only in every new agent sandbox. A repository can ask for one by name; only you can put it here."/>

            <!-- Loading: a named line, never a blank list. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"
                        IsVisible="{Binding IsLoading}">
                <PathIcon Classes="spinning" Data="{StaticResource RefreshIcon}" Width="14" Height="14"
                          Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Checking which toolchains are installed…" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

                    <!-- Catalog read failed: the cause + the way forward, inline. -->
                    <Border Classes="Card" Background="{DynamicResource SurfaceCard}" CornerRadius="8"
                            Padding="14" IsVisible="{Binding HasLoadError}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource WarningIcon}" Width="16" Height="16"
                                          Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding LoadError}" FontSize="12" MaxWidth="500"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Content="Try again" Classes="Primary" Padding="14,6" HorizontalAlignment="Right"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Toolchains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ToolchainRowViewModel">
                                <Border Classes="Card" Background="{DynamicResource SurfaceCard}"
                                        CornerRadius="8" Padding="14" Margin="0,0,0,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Health/lifecycle glyph: icon + text below, never colour alone. -->
                                        <Panel Grid.Column="0" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <PathIcon Data="{StaticResource CheckmarkIcon}" Width="18" Height="18"
                                                      Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsInstalled}"/>
                                            <PathIcon Classes="spinning" Data="{StaticResource RefreshIcon}" Width="16" Height="16"
                                                      Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsWorking}"/>
                                            <PathIcon Data="{StaticResource TerminalIcon}" Width="16" Height="16"
                                                      Foreground="{DynamicResource TextMuted}" IsVisible="{Binding IsIdle}"/>
                                        </Panel>

                                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!-- MaxWidth bounds the measure so TextTrimming actually engages inside the
                                                     horizontal StackPanel (unbounded, it would collide with the buttons). -->
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" MaxWidth="260"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border CornerRadius="999" Background="{DynamicResource AccentSelection}"
                                                        Padding="8,1" VerticalAlignment="Center">
                                                    <TextBlock Classes="Mono" Text="{Binding VersionLabel}" FontSize="10"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" MaxWidth="420"
                                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Installed — it was just run at the pinned version" FontSize="11"
                                                       Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsInstalled}"/>
                                            <!-- What the probe actually printed: the proof behind "Installed". -->
                                            <TextBlock Classes="Mono" Text="{Binding Detail}" FontSize="10" MaxWidth="420"
                                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                       IsVisible="{Binding ShowInstalledDetail}"/>
                                            <!-- Not installed — or installed as some OTHER version, which the channel
                                                 reports here as not installed, in words. -->
                                            <TextBlock Text="{Binding NotInstalledDetail}" FontSize="11" MaxWidth="420"
                                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                       IsVisible="{Binding CanInstall}"/>
                                            <!-- Progress detail (muted) vs failure cause (icon + danger text). -->
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="HasStatusMessage"/>
                                                        <Binding Path="!IsFailed"/>
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsFailed}">
                                                <PathIcon Data="{StaticResource WarningIcon}" Width="12" Height="12"
                                                          Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top"
                                                          Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" MaxWidth="420"
                                                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Install" Classes="Primary" Padding="14,5"
                                                    IsVisible="{Binding CanInstall}"
                                                    Command="{Binding $parent[UserControl].((vm:ToolchainSettingsViewModel)DataContext).InstallCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Remove" Classes="Secondary" Padding="14,5"
                                                    IsVisible="{Binding CanRemove}"
                                                    Command="{Binding $parent[UserControl].((vm:ToolchainSettingsViewModel)DataContext).RemoveCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="This Mainguard release curates no language toolchains — check for a Mainguard update."
                               Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="4,8"
                               IsVisible="{Binding ShowEmpty}"/>

                    <!-- Second section of the same page: declaring a toolchain in the OPEN repository.
                         The list above answers "is it on this machine"; this answers "does this repo ask
                         for it". Absent (not inert) when there is no repository context to give it. -->
                    <views:ToolchainDeclarationView DataContext="{Binding Declaration}"
                                                    IsVisible="{Binding $parent[UserControl].((vm:ToolchainSettingsViewModel)DataContext).HasDeclaration}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsBusy}">
                    <TextBlock Text="Working — you can cancel anytime; a finished install stays."
                               FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Cancel" Classes="Secondary" Padding="15,6"
                            IsVisible="{Binding IsBusy}" Command="{Binding CancelCommand}"/>
                    <Button Content="Refresh" Classes="Primary" Padding="15,6"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
